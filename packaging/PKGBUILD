# Maintainer: bstar <bob@dinicolas.com>
pkgname=staramp
pkgver=0.1.0
pkgrel=1
pkgdesc="A Winamp-feel terminal music player for local libraries"
arch=('x86_64' 'aarch64')
url="https://github.com/bstar/staramp"
license=('MIT')
depends=('alsa-lib' 'ffmpeg' 'dbus' 'gcc-libs')
makedepends=('cargo' 'clang' 'pkgconf')
# The default glyph set uses the media control pictographs (U+23EE and
# neighbours), which many terminal fonts lack. Optional rather than required:
# `[ui] glyphs = "ascii"` needs nothing, and only the terminal can choose the
# font staramp is drawn in -- installing one does not select it.
optdepends=(
  'noto-fonts: glyphs for the default transport buttons'
  'ttf-nerd-fonts-symbols: glyphs for [ui] glyphs = "nerd"'
)
# makepkg enables LTO by default, which makes the C that rusqlite and blake3
# compile land in the static archives as LTO bitcode. rustc links with lld,
# which does not read it, and every sqlite3_* symbol comes back undefined. The
# Rust toolchain does its own LTO through the release profile regardless.
options=(!lto)
# The release tarball, not GitHub's generated /archive/ one: that is produced
# on the fly and its bytes have changed under the AUR before, invalidating
# every checksum at once. This one is built by `git archive` at the tag and
# uploaded, so the hash below is a real check rather than a formality.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # ffmpeg-next runs bindgen and needs libclang.
  export LIBCLANG_PATH="/usr/lib"
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export LIBCLANG_PATH="/usr/lib"
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 NOTICE  "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 packaging/staramp.desktop \
    "$pkgdir/usr/share/applications/staramp.desktop"
  install -Dm0644 packaging/staramp.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/staramp.png"
  install -Dm0644 packaging/staramp.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/staramp.svg"
}

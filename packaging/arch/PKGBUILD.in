# Generated by scripts/dist/arch.sh for the exact checkout being built.
pkgname=staramp
pkgver=@VERSION@
pkgrel=1
pkgdesc='A terminal music player in the STAR family'
arch=('x86_64')
url='https://github.com/bstar/staramp'
license=('MIT' 'LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'alsa-lib')
makedepends=('rust>=1.90' 'git' 'clang' 'pkgconf')
optdepends=('vulkan-icd-loader: GPU rendering for the graphical visualizer'
            'pipewire-alsa: play through PipeWire')
options=('!lto' '!debug')
source=("staramp-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

_cargo_env() {
    export CARGO_HOME="${ARCH_CARGO_HOME:-$srcdir/cargo}"
    export CARGO_TARGET_DIR="$srcdir/target"
    export CARGO_NET_GIT_FETCH_WITH_CLI=true
}

prepare() {
    cd "$srcdir/staramp-$pkgver"
    _cargo_env
    cargo fetch --locked
}

build() {
    cd "$srcdir/staramp-$pkgver"
    _cargo_env
    cargo build --release --frozen
}

check() {
    cd "$srcdir/staramp-$pkgver"
    _cargo_env
    cargo test --release --frozen --all
}

package() {
    cd "$srcdir/staramp-$pkgver"
    install -Dm755 "$srcdir/target/release/staramp" "$pkgdir/usr/bin/staramp"
    install -Dm644 packaging/staramp.desktop "$pkgdir/usr/share/applications/staramp.desktop"
    install -Dm644 packaging/staramp.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/staramp.png"
    install -Dm644 packaging/staramp.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/staramp.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/staramp/LICENSE"
    install -Dm644 LICENSES/ffmpeg-LGPL-2.1.txt "$pkgdir/usr/share/licenses/staramp/ffmpeg-LGPL-2.1.txt"
    install -Dm644 NOTICE "$pkgdir/usr/share/doc/staramp/NOTICE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/staramp/README.md"
}
